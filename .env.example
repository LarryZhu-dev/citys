# Local: npm install && npm start. .env is read by Node; never commit it.
PORT=3000
HOST=0.0.0.0
# Production: use a managed Postgres pooled connection URL with TLS.
# Vercel refuses all online functions unless DATABASE_URL is set and reachable.
# DATABASE_URL=postgresql://user:password@host:5432/citys?sslmode=verify-full
# Set the exact public origin in production (no trailing slash).
# APP_ORIGIN=https://your-game.vercel.app
# Optional private-server development store; never used on Vercel/production.
# DATA_FILE=./work/local-online.json
