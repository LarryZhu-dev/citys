{
  "name": "chronicles-of-civilization",
  "version": "2.2.0",
  "private": true,
  "description": "Ancient city builder with persistent community services",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.cjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.cjs",
    "build": "node server/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:online": "node --test tests/online.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:visual": "node tests/godot-browser.cjs",
    "test:production": "node tests/production-smoke.cjs",
    "engine:export": "node server/export-godot.cjs",
    "test:godot": "node tests/godot-browser.cjs",
    "test:input": "node tests/godot-input.cjs",
    "test:revision": "node tests/revision-browser.cjs",
    "test:performance": "node tests/godot-performance.cjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
